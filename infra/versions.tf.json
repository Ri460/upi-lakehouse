{
  "terraform": {
    "required_version": ">= 1.10.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.90"
      }
    },
    "backend": {
      "s3": {}
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}",
      "default_tags": {
        "tags": {
          "Project": "${var.name}",
          "ManagedBy": "Terraform"
        }
      }
    }
  }
}
